# Eryx Hardware — environment variables
# Copy these into the Railway service (Variables tab). Do NOT commit real values.
# Every var below is read by application code; grep src/ if you need to confirm a call site.

# ── Supabase ────────────────────────────────────────────────────────────────
# Public (safe to expose to the browser). Project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Service-role key bypasses RLS — NEVER expose to client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ────────────────────────────────────────────────────────────────
# Server-only key pair used to create orders.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public key id used by the browser checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only. Verifies the webhook HMAC signature. Must match the secret
# configured on the Razorpay webhook that points at /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=
# Where customer/admin notification emails are sent / shown as sender.
SUPPORT_EMAIL=
NOTIFICATION_FROM_EMAIL=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Bearer secret for the manual/debug order-release sweep at
# /api/cron/release-expired-orders. The primary sweep runs in Supabase pg_cron,
# so this is only needed if you trigger the sweep by hand.
CRON_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Not read anywhere in src/ today (auth redirects derive from the request
# origin), but set it to the production origin for future absolute-URL needs.
NEXT_PUBLIC_SITE_URL=https://eryxhardware.com
